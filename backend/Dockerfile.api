# Minimal native API image. The isolated parser image and ingestion daemon are
# deliberately separate; this runtime has no Docker binary or socket.
FROM python:3.12.16-slim-trixie@sha256:f3aa44c1f89302501f8b812a3abe4ca997177f227e295d9a76ac0d683b493800 AS debian

# Refresh security fixes in the pinned Debian base without changing distribution.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

FROM debian AS openssl-build
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential dpkg-dev perl zlib1g-dev libzstd-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /openssl
ADD --checksum=sha256:b038dfab5ee111242b7439e07c820d228519273e7fd1f514014b039e929aad9f \
    https://deb.debian.org/debian/pool/main/o/openssl/openssl_3.5.9-1~deb13u1.dsc ./
ADD --checksum=sha256:603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a \
    https://deb.debian.org/debian/pool/main/o/openssl/openssl_3.5.9.orig.tar.gz ./
ADD --checksum=sha256:bdccf2057a7c4ae377b40e832cb8c632ae8b532d4fb64cc7b843066eee748f89 \
    https://deb.debian.org/debian/pool/main/o/openssl/openssl_3.5.9.orig.tar.gz.asc ./
ADD --checksum=sha256:7d5158a87cd24641316b050de419be4ebddb1f180afd7ebaa3bc990036c38ec6 \
    https://deb.debian.org/debian/pool/main/o/openssl/openssl_3.5.9-1~deb13u1.debian.tar.xz ./
COPY scripts/build_native_openssl.sh /build_native_openssl.sh
RUN sh /build_native_openssl.sh

FROM debian AS builder
COPY --from=openssl-build /openssl/runtime/ /openssl-runtime/
RUN test "$(dpkg-query -W -f='${Version}' libssl3t64)" = '3.5.9-1~deb13u1' \
    && ssl_path="$(dpkg-query -L libssl3t64 | grep '/libssl\.so\.3$')" \
    && install -m 0644 /openssl-runtime/libssl.so.3 "$ssl_path"
COPY --from=ghcr.io/astral-sh/uv:0.13.4@sha256:9f130421e930bfbdc563c00740466603f8723158e90297d07957c2294640262b /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-cache --no-dev --no-install-project
COPY scripts/prepare_native_runtime.py /prepare_native_runtime.py
RUN python /prepare_native_runtime.py
RUN install -m 0644 /openssl-runtime/openssl-build.json /native-runtime/usr/share/kova/openssl-build.json

# Explicit runtime copies exclude .env, local credentials, tests, migrations,
# and scripts even if a build client neglects the project .dockerignore.
COPY app ./app
COPY presets ./presets
RUN find /app/app -type d -name tests -prune -exec rm -rf {} +

# Same Debian/glibc ABI as the Python builder, with no shell, package manager,
# mount/login tools, systemd or Perl. Package metadata remains available to SCA.
FROM gcr.io/distroless/base-debian13:nonroot@sha256:f9518b74815721f537a7458cc693b4406208c04fce23bbffab511516117f34fd
COPY --from=builder /native-runtime/ /
COPY --from=builder /app/ /app/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:/usr/local/bin" \
    LD_LIBRARY_PATH=/usr/local/lib \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    APP_ENV=production \
    CLOUDFLARE_CONTAINER_MODE=true \
    ASSISTANT_DOCUMENTS_ENABLED=false \
    ASSISTANT_INGEST_ON_DEMAND=false
ARG KOVA_RELEASE_SHA=unknown
ENV KOVA_RELEASE_SHA=$KOVA_RELEASE_SHA \
    KOVA_IMAGE_SHA=$KOVA_RELEASE_SHA
WORKDIR /app
USER 10001:10001
ENTRYPOINT []
EXPOSE 8000
# The container port has no public ingress. Its controller overwrites
# X-Forwarded-Proto/Host and removes Forwarded/X-Forwarded-For before forwarding;
# only that private hop may supply proxy metadata. Preserve HTTPS slash redirects
# even though the container SDK's final transport uses HTTP internally.
CMD ["uvicorn", "app.native:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*", "--no-access-log"]
