# Copy to .env for local development. .env is gitignored.
# No real secrets in this file.

APP_ENV=local

# Database
# The app connects via DATABASE_URL. It can point to either:
#   (A) The local Postgres container in docker-compose (default below), or
#   (B) A Supabase project's Postgres connection string (dev/staging/prod).
#
# Supabase is the intended hosted database provider for staging and production.
# See docs/deployment.md and specs/shared/local_dev.md.
#
# (A) Local Docker Postgres (default for `docker compose up`):
DATABASE_URL=postgresql+psycopg://pos:pos@db:5432/pos

# (B) To point local dev at a Supabase dev project instead, replace with:
# DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres
# Use the connection string from the Supabase dashboard (Settings > Database).
# Prefer the connection pooler URL (port 6543) for serverless / many short-lived connections.

# Local Postgres container settings (only used when DATABASE_URL points at the
# `db` service in docker-compose; ignored when DATABASE_URL points at Supabase):
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=pos

# Backend
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_SENTRY_DSN=

# Billing
# Real values must live in the hosting provider's secret store or local .env.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STANDARD_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/billing/cancel
BILLING_GRACE_PERIOD_DAYS=7
INTERNAL_API_KEY=

# Supabase (frontend)
# Reserved for when the frontend talks directly to Supabase (e.g. storage).
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
