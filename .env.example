# Backend environment variables — copy to .env and supply real values.
# This file contains only safe placeholders. No real secrets belong here.
# Supply real values via your hosting provider's secret manager (Fly.io secrets,
# Vercel environment variables, GitHub Actions secrets).

# ── Core ──────────────────────────────────────────────────────────────────────
# One of: local | staging | production
APP_ENV=local

# Supabase connection string (Session mode pooler recommended for migrations).
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://pos:pos@db:5432/pos

# URL the backend allows as a CORS origin for the frontend.
FRONTEND_URL=http://localhost:5173

# ── Security ──────────────────────────────────────────────────────────────────
# Long random string used to sign JWT access and refresh tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Required in staging/production — startup fails if this is still the default.
SECRET_KEY=

# ── Observability (optional) ──────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Frontend Sentry DSN — safe to expose to the browser (VITE_ prefix required).
VITE_SENTRY_DSN=

# ── Stripe (optional — required in production for billing) ────────────────────
# Secret key: server-only, never expose to the browser.
STRIPE_SECRET_KEY=
# Webhook signing secret from the Stripe dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
# Price ID for the standard subscription plan.
STRIPE_STANDARD_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=

# ── Email — Resend (optional — required in production) ────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Internal service auth (optional) ─────────────────────────────────────────
# Shared secret for trusted server-to-server calls (e.g., cron jobs).
INTERNAL_API_KEY=

# ── Internal ops dashboard (optional) ────────────────────────────────────────
# Founder-only access to /api/v1/internal/ops/*. In production both values are
# required together and exactly one email is allowed. Empty disables access.
INTERNAL_ADMIN_EMAILS=
INTERNAL_ADMIN_USER_ID=

# Connector tokens for the ops dashboard — all optional; a missing token shows
# that integration as "not_configured" instead of failing. Server-side only.
# Sentry org auth token (scopes: org:read, project:read, event:read).
SENTRY_API_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=
SENTRY_FRONTEND_PROJECT_SLUG=
# Fly.io deploy/org token with read access to the app.
FLY_API_TOKEN=
FLY_APP_NAME=pos-project-backend
# Vercel personal/team token with read access to the project deployments.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# UptimeRobot main or read-only API key.
UPTIMEROBOT_API_KEY=
# Git commit SHA of the running build — set by CI on deploy; used as the Sentry
# release and shown in the ops dashboard for deploy correlation.
GIT_SHA=

# ── Rate limiting — Upstash Redis (optional) ─────────────────────────────────
# When both are set, the limiter uses Upstash Redis (required for multi-replica).
# Without these, a single-process in-memory limiter is used (local/single-instance only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
